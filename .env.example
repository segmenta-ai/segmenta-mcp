# Segmenta MCP Server — env template
# Su VM Oracle: cp .env.example .env && chmod 600 .env && vim .env
# NEVER committare il .env reale con secrets

# === Server core ===
ENV=production
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
ISSUER_URL=https://mcp.segmentamarketing.com

# === OAuth / JWT (RS256, D-AU-004) ===
# Generate keypair locally:
#   openssl genpkey -algorithm RSA -out jwt_private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Paste here (multi-line OK with \n separator or use heredoc on .env)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=key-2026-05
OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,chatgpt.com,cursor.so

# === Redis (Upstash free tier) ===
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
REDIS_TLS=true

# === Email (Resend free tier 100/giorno) ===
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Pre-verifica dominio (durante M0/M1): usa l'address di test Resend
# RESEND_FROM_EMAIL=onboarding@resend.dev
# Post-verifica dominio (BL-004 chiusa + record DNS Merari aggiunti, Resend mostra "Verified"):
# Nota: Resend usa subdomain `send.` (anti-deliverability best practice)
RESEND_FROM_EMAIL=hola@send.mcp.segmentamarketing.com

# === CRM (HubSpot — DECISION-OPEN-003 default, M2 confirm con Merari) ===
HUBSPOT_PRIVATE_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# === Booking (Cal.com — DECISION-OPEN-002 default, M2 confirm con Merari) ===
CALCOM_API_KEY=cal_xxxxxxxxxxxxxxxx
CALCOM_USERNAME=segmenta
CALCOM_WEBHOOK_SECRET=

# === Slack notifications ===
SLACK_WEBHOOK_URL_LEADS_MCP=https://hooks.slack.com/services/xxx
SLACK_WEBHOOK_URL_ALERTS_MCP=https://hooks.slack.com/services/yyy
SLACK_WEBHOOK_URL_DEPLOYS=https://hooks.slack.com/services/zzz

# === Geo IP (free tier, opzionale) ===
IPINFO_TOKEN=

# === SEO data (DataForSEO — Tier 3 only, attivare in M4) ===
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
